<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SubManager</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

  :root {
    --bg: #0f0f13;
    --surface: #1a1a24;
    --surface2: #22222f;
    --border: #2e2e3e;
    --accent: #7c6ff7;
    --accent2: #a78bfa;
    --text: #f0f0f5;
    --text2: #9090a8;
    --text3: #5a5a72;
    --danger: #f87171;
    --success: #4ade80;
    --warning: #fbbf24;
    --radius: 16px;
    --radius-sm: 10px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }

  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(15,15,19,0.85); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 0 24px; display: flex; align-items: center;
    justify-content: space-between; height: 60px;
  }
  .nav-logo {
    font-size: 18px; font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .nav-tabs { display: flex; gap: 4px; }
  .nav-tab {
    padding: 8px 18px; border-radius: 8px; font-size: 14px;
    font-weight: 500; cursor: pointer; color: var(--text2);
    border: none; background: transparent; transition: all 0.2s;
    font-family: 'Inter', sans-serif;
  }
  .nav-tab:hover { background: var(--surface); color: var(--text); }
  .nav-tab.active { background: var(--surface2); color: var(--text); }

  main { max-width: 760px; margin: 0 auto; padding: 32px 20px 80px; }
  .page { display: none; }
  .page.active { display: block; }

  .page-title { font-size: 26px; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 6px; }
  .page-sub { font-size: 14px; color: var(--text2); margin-bottom: 28px; }

  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px; margin-bottom: 16px;
  }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-group.full { grid-column: 1 / -1; }

  label { font-size: 12px; font-weight: 600; color: var(--text2); letter-spacing: 0.5px; text-transform: uppercase; }

  input {
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: var(--radius-sm); color: var(--text);
    font-family: 'Inter', sans-serif; font-size: 15px;
    padding: 12px 14px; outline: none; transition: border-color 0.2s;
  }
  input:focus { border-color: var(--accent); }
  input[readonly] { color: var(--accent2); cursor: default; border-color: transparent; background: rgba(124,111,247,0.08); }
  input::placeholder { color: var(--text3); }

  .btn {
    border: none; border-radius: var(--radius-sm);
    font-family: 'Inter', sans-serif; font-size: 14px;
    font-weight: 600; cursor: pointer; transition: all 0.2s; padding: 12px 20px;
  }
  .btn-primary { background: var(--accent); color: #fff; flex: 1; }
  .btn-primary:hover { background: #6a5ef0; transform: translateY(-1px); }
  .btn-ghost { background: var(--surface2); color: var(--text2); border: 1px solid var(--border); }
  .btn-ghost:hover { color: var(--text); border-color: var(--text3); }
  .btn-danger {
    background: rgba(248,113,113,0.12); color: var(--danger);
    border: 1px solid rgba(248,113,113,0.2); padding: 8px 14px; font-size: 13px;
  }
  .btn-danger:hover { background: rgba(248,113,113,0.2); }
  .btn-row { display: flex; gap: 10px; margin-top: 20px; }

  .list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .count-badge {
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 20px; padding: 4px 12px; font-size: 13px; color: var(--text2);
  }
  .sub-list { display: flex; flex-direction: column; gap: 10px; }
  .sub-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 18px 20px;
    display: flex; align-items: center; gap: 16px;
    transition: all 0.2s; animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
  .sub-card:hover { border-color: var(--text3); }
  .sub-icon {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 16px; flex-shrink: 0;
  }
  .sub-info { flex: 1; min-width: 0; }
  .sub-name { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
  .sub-meta { font-size: 13px; color: var(--text2); }
  .sub-right { text-align: right; flex-shrink: 0; }
  .sub-fee { font-size: 17px; font-weight: 700; margin-bottom: 4px; }
  .sub-share { font-size: 12px; color: var(--text2); }
  .due-badge {
    background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.25);
    color: var(--warning); font-size: 11px; font-weight: 600;
    padding: 3px 8px; border-radius: 6px; margin-left: 8px;
  }
  .empty-state { text-align: center; padding: 60px 20px; color: var(--text3); }
  .empty-title { font-size: 16px; font-weight: 500; color: var(--text2); margin-bottom: 6px; }
  .empty-desc { font-size: 14px; }

  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
  .stat-label { font-size: 12px; color: var(--text2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
  .stat-value { font-size: 28px; font-weight: 700; letter-spacing: -1px; }
  .stat-unit { font-size: 14px; color: var(--text2); font-weight: 400; margin-left: 4px; }
  .stat-card.accent { border-color: rgba(124,111,247,0.3); background: rgba(124,111,247,0.06); }
  .stat-card.accent .stat-value { color: var(--accent2); }
  .due-list { display: flex; flex-direction: column; gap: 8px; }
  .due-item {
    background: var(--surface2); border: 1px solid rgba(251,191,36,0.2);
    border-radius: var(--radius-sm); padding: 14px 16px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .due-name { font-size: 14px; font-weight: 500; }
  .due-day { font-size: 13px; color: var(--warning); font-weight: 600; }
  .due-none { font-size: 14px; color: var(--text3); padding: 20px 0; text-align: center; }

  .toast {
    position: fixed; bottom: 30px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 10px; padding: 12px 20px; font-size: 14px; font-weight: 500;
    opacity: 0; transition: all 0.3s; pointer-events: none; white-space: nowrap; z-index: 999;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .toast.success { border-color: rgba(74,222,128,0.3); color: var(--success); }
  .toast.error { border-color: rgba(248,113,113,0.3); color: var(--danger); }

  @media (max-width: 480px) {
    .form-grid { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<nav>
  <div class="nav-logo">SubManager</div>
  <div class="nav-tabs">
    <button class="nav-tab active" onclick="app.showPage('register', this)">등록</button>
    <button class="nav-tab" onclick="app.showPage('list', this)">목록</button>
    <button class="nav-tab" onclick="app.showPage('stats', this)">통계</button>
  </div>
</nav>

<main>
  <div class="page active" id="page-register">
    <div class="page-title">구독 등록</div>
    <div class="page-sub">새로운 구독 서비스를 추가하세요</div>
    <div class="card">
      <div class="form-grid">
        <div class="form-group full">
          <label>서비스명</label>
          <input type="text" id="inp-name" placeholder="예) 넷플릭스, 스포티파이">
        </div>
        <div class="form-group">
          <label>결제일</label>
          <input type="number" id="inp-day" placeholder="1 ~ 31" min="1" max="31">
        </div>
        <div class="form-group">
          <label>월 금액 (원)</label>
          <input type="number" id="inp-fee" placeholder="예) 17000" oninput="app.calcShare()">
        </div>
        <div class="form-group">
          <label>인원수</label>
          <input type="number" id="inp-party" placeholder="혼자면 1" min="1" value="1" oninput="app.calcShare()">
        </div>
        <div class="form-group">
          <label>내 부담금 (자동계산)</label>
          <input type="text" id="inp-share" readonly placeholder="자동 계산">
        </div>
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" onclick="app.addSub()">등록하기</button>
        <button class="btn btn-ghost" onclick="app.clearForm()">초기화</button>
      </div>
    </div>
  </div>

  <div class="page" id="page-list">
    <div class="list-header">
      <div>
        <div class="page-title">구독 목록</div>
        <div class="page-sub">등록된 구독 서비스</div>
      </div>
      <div class="count-badge" id="count-badge">0개</div>
    </div>
    <div class="sub-list" id="sub-list"></div>
  </div>

  <div class="page" id="page-stats">
    <div class="page-title">통계</div>
    <div class="page-sub">이번 달 지출 현황</div>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">이번 달 총 지출</div>
        <div><span class="stat-value" id="stat-total">0</span><span class="stat-unit">원</span></div>
      </div>
      <div class="stat-card accent">
        <div class="stat-label">내 실제 부담금</div>
        <div><span class="stat-value" id="stat-share">0</span><span class="stat-unit">원</span></div>
      </div>
    </div>
    <div class="card">
      <div class="stat-label" style="margin-bottom:14px">결제 임박 (3일 이내)</div>
      <div id="due-list" class="due-list"></div>
    </div>
  </div>
</main>

<div class="toast" id="toast"></div>

<script>
// =====================================================
//  Expense 클래스 - 구독 데이터 (MFC의 Expense.h와 동일 구조)
// =====================================================
class Expense {
  constructor(name, day, fee, party) {
    this.id = Date.now();
    this.name = name;
    this.paymentDay = day;
    this.monthlyFee = fee;
    this.partySize = party;
  }

  // 내 부담금 자동 계산
  getMyShare() {
    return this.partySize > 0 ? Math.floor(this.monthlyFee / this.partySize) : this.monthlyFee;
  }

  // 결제 임박 여부 (3일 이내)
  isDueSoon(today) {
    const diff = this.paymentDay - today;
    return diff >= 0 && diff <= 3;
  }
}

// =====================================================
//  SubManager 클래스 - 구독 목록 관리 (MFC의 SubManager.h와 동일 구조)
// =====================================================
class SubManager {
  constructor() {
    this.subList = [];
    this.logList = [];
  }

  addSubscription(expense) {
    this.subList.push(expense);
    this.logList.push(`[등록] ${expense.name} / ${expense.monthlyFee}원 / ${expense.paymentDay}일 / ${expense.partySize}명`);
  }

  removeSubscription(id) {
    const sub = this.subList.find(s => s.id === id);
    if (sub) {
      this.logList.push(`[해지] ${sub.name}`);
      this.subList = this.subList.filter(s => s.id !== id);
      return true;
    }
    return false;
  }

  getTotalMonthly() {
    return this.subList.reduce((sum, s) => sum + s.monthlyFee, 0);
  }

  getMyShareTotal() {
    return this.subList.reduce((sum, s) => sum + s.getMyShare(), 0);
  }

  getDueSoon(today) {
    return this.subList.filter(s => s.isDueSoon(today));
  }
}

// =====================================================
//  UI 클래스 - 화면 렌더링 및 이벤트 처리
// =====================================================
class App {
  constructor() {
    this.manager = new SubManager();
    this.colors = [
      { bg: 'rgba(124,111,247,0.15)', color: '#a78bfa' },
      { bg: 'rgba(74,222,128,0.15)',  color: '#4ade80' },
      { bg: 'rgba(251,191,36,0.15)',  color: '#fbbf24' },
      { bg: 'rgba(248,113,113,0.15)', color: '#f87171' },
      { bg: 'rgba(56,189,248,0.15)',  color: '#38bdf8' },
      { bg: 'rgba(251,146,60,0.15)',  color: '#fb923c' },
    ];
    this.renderList();
    this.renderStats();
  }

  getColor(index) {
    return this.colors[index % this.colors.length];
  }

  showPage(name, btn) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
    document.getElementById('page-' + name).classList.add('active');
    btn.classList.add('active');
    if (name === 'list') this.renderList();
    if (name === 'stats') this.renderStats();
  }

  calcShare() {
    const fee = parseInt(document.getElementById('inp-fee').value) || 0;
    const party = parseInt(document.getElementById('inp-party').value) || 1;
    const share = Math.floor(fee / party);
    document.getElementById('inp-share').value = share > 0 ? share.toLocaleString() + ' 원' : '';
  }

  addSub() {
    const name  = document.getElementById('inp-name').value.trim();
    const day   = parseInt(document.getElementById('inp-day').value);
    const fee   = parseInt(document.getElementById('inp-fee').value);
    const party = parseInt(document.getElementById('inp-party').value) || 1;

    if (!name)                    return this.showToast('서비스명을 입력해주세요', 'error');
    if (!day || day < 1 || day > 31) return this.showToast('결제일은 1~31 사이로 입력해주세요', 'error');
    if (!fee || fee <= 0)         return this.showToast('월 금액을 입력해주세요', 'error');

    const expense = new Expense(name, day, fee, party);
    this.manager.addSubscription(expense);
    this.showToast(name + ' 등록 완료!', 'success');
    this.clearForm();
  }

  clearForm() {
    document.getElementById('inp-name').value  = '';
    document.getElementById('inp-day').value   = '';
    document.getElementById('inp-fee').value   = '';
    document.getElementById('inp-party').value = '1';
    document.getElementById('inp-share').value = '';
  }

  deleteSub(id) {
    this.manager.removeSubscription(id);
    this.renderList();
    this.showToast('삭제되었습니다', 'success');
  }

  renderList() {
    const today = new Date().getDate();
    const list  = this.manager.subList;
    document.getElementById('count-badge').textContent = list.length + '개';
    const el = document.getElementById('sub-list');

    if (list.length === 0) {
      el.innerHTML = `
        <div class="empty-state">
          <div style="font-size:40px;opacity:0.3;margin-bottom:12px">—</div>
          <div class="empty-title">등록된 구독이 없어요</div>
          <div class="empty-desc">등록 탭에서 구독을 추가해보세요</div>
        </div>`;
      return;
    }

    el.innerHTML = list.map((s, i) => {
      const c = this.getColor(i);
      const dueSoon = s.isDueSoon(today);
      const diff = s.paymentDay - today;
      return `
        <div class="sub-card">
          <div class="sub-icon" style="background:${c.bg};color:${c.color}">${s.name[0]}</div>
          <div class="sub-info">
            <div class="sub-name">${s.name}${dueSoon ? `<span class="due-badge">D-${diff}</span>` : ''}</div>
            <div class="sub-meta">매월 ${s.paymentDay}일 결제 · ${s.partySize}명</div>
          </div>
          <div class="sub-right">
            <div class="sub-fee">${s.monthlyFee.toLocaleString()}원</div>
            <div class="sub-share">내 부담 ${s.getMyShare().toLocaleString()}원</div>
          </div>
          <button class="btn btn-danger" onclick="app.deleteSub(${s.id})">삭제</button>
        </div>`;
    }).join('');
  }

  renderStats() {
    const today = new Date().getDate();
    document.getElementById('stat-total').textContent = this.manager.getTotalMonthly().toLocaleString();
    document.getElementById('stat-share').textContent = this.manager.getMyShareTotal().toLocaleString();

    const dueSoon = this.manager.getDueSoon(today);
    const el = document.getElementById('due-list');
    if (dueSoon.length === 0) {
      el.innerHTML = '<div class="due-none">결제 임박 서비스가 없어요</div>';
    } else {
      el.innerHTML = dueSoon.map(s => `
        <div class="due-item">
          <div class="due-name">${s.name}</div>
          <div class="due-day">D-${s.paymentDay - today} · ${s.paymentDay}일</div>
        </div>`).join('');
    }
  }

  showToast(msg, type = '') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast ' + type + ' show';
    setTimeout(() => t.classList.remove('show'), 2500);
  }
}

// 앱 시작
const app = new App();
</script>
</body>
</html>
